<!doctype html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>Smart DAW — Amapiano Production Studio</title>
<link rel="stylesheet" href="assets/tokens.css">
<link rel="stylesheet" href="css/daw.css">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%232F6FEB'/%3E%3Cpath d='M20 40 L28 24 L36 36 L44 20 L52 32' fill='none' stroke='white' stroke-width='4' stroke-linecap='round'/%3E%3C/svg%3E">
<script src="assets/icons.js"></script>
<style>
/* DAW-specific CSS following Smart Design laws */
:root {
  --daw-pane-header: 32px;
  --daw-pane-gap: 12px;
  --daw-knob-size: 44px;
  --daw-fader-width: 34px;
  --daw-grid-min: 16px;
  --daw-playhead-width: 2px;
  --daw-row-height: 32px;
}

/* DAW appbar override - compact */
.daw-appbar {
  height: 52px;
  padding: 0 12px;
}

/* DAW pane base */
.daw-pane {
  position: relative;
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 0;
  background: linear-gradient(180deg, var(--panel-top), var(--panel-bottom));
  border-radius: var(--r-panel);
  box-shadow: var(--e1);
  overflow: hidden;
  border: 1px solid var(--hair);
}

.daw-pane-header {
  flex: none;
  height: var(--daw-pane-header);
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 10px;
  background: linear-gradient(180deg, var(--control), var(--field));
  border-bottom: 1px solid var(--hair);
  -webkit-app-region: drag;
}

.daw-pane-title {
  font-size: var(--t-label);
  font-weight: var(--weight-medium);
  letter-spacing: var(--tracking-label);
  text-transform: uppercase;
  color: var(--ink-2);
}

.daw-pane-actions {
  margin-left: auto;
  display: flex;
  gap: 4px;
  -webkit-app-region: no-drag;
}

.daw-pane-content {
  flex: 1;
  min-height: 0;
  overflow: auto;
  padding: var(--sp-gap-sm);
}

/* Traffic lights */
.traffic {
  display: flex;
  gap: 8px;
  -webkit-app-region: no-drag;
}

.traffic .dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  box-shadow: inset 0 0 0 .5px rgba(0,0,0,.10), inset 0 1px 0 rgba(255,255,255,.35), 0 .5px 1px rgba(20,29,48,.10);
  transition: transform var(--dur-1) var(--ease-out), filter var(--dur-1) ease;
}

.traffic .dot:hover { transform: scale(1.14); filter: brightness(1.04); }
.traffic .dot:active { transform: scale(.96); }
.traffic .dot svg { width: 8px; height: 8px; stroke: rgba(40,20,18,.52); stroke-width: 1.35; fill: none; stroke-linecap: round; opacity: 0; transition: opacity var(--dur-1) ease; }
.traffic:hover .dot svg { opacity: 1; }
.traffic .dot.close { background: linear-gradient(180deg,#ff7c72,#f2554c); }
.traffic .dot.min { background: linear-gradient(180deg,#ffd264,#f5b93c); }
.traffic .dot.zoom { background: linear-gradient(180deg,#6fdc8c,#38bd62); }

/* Skeuomorphic knob */
.skeu-knob {
  position: relative;
  width: var(--daw-knob-size);
  height: var(--daw-knob-size);
  border-radius: 50%;
  background: linear-gradient(180deg, var(--control-hover), var(--control));
  box-shadow: var(--rim-1), var(--e1);
  cursor: ew-resize;
  touch-action: none;
  display: grid;
  place-items: center;
  transition: transform var(--dur-1) var(--ease-out);
}

.skeu-knob::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.35) 0%, transparent 40%);
  pointer-events: none;
}

.skeu-knob::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: radial-gradient(circle at 70% 70%, rgba(0,0,0,0.20) 0%, transparent 40%);
  pointer-events: none;
}

.skeu-knob .pointer {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 2px;
  height: 14px;
  background: var(--ink-1);
  transform-origin: top center;
  transform: translate(-50%, -50%) rotate(var(--knob-rot, 0deg)) translateY(-14px);
  border-radius: 1px;
  transition: transform var(--dur-1) ease;
}

.skeu-knob .value-ring {
  position: absolute;
  inset: 2px;
  border-radius: 50%;
  border: 4px solid transparent;
  border-top: 4px solid var(--accent);
  border-right: 4px solid var(--accent);
  transform: rotate(var(--knob-rot, 0deg));
  pointer-events: none;
  opacity: 0;
  transition: opacity var(--dur-1) ease;
}

.skeu-knob:focus-visible .value-ring,
.skeu-knob.active .value-ring { opacity: 0.6; }

.skeu-knob:active { transform: scale(0.96); }

.skeu-knob-label {
  font-size: var(--t-micro);
  color: var(--ink-3);
  text-align: center;
  line-height: 1.1;
  margin-top: var(--sp-gap-xs);
}

/* Skeuomorphic fader */
.skeu-fader-track {
  position: relative;
  width: var(--daw-fader-width);
  height: 160px;
  background: var(--control);
  border: 1px solid var(--hair);
  border-radius: var(--r-item);
  box-shadow: var(--rim-well);
  background-image: linear-gradient(180deg, rgba(255,255,255,0.25) 0%, transparent 40%, transparent 60%, rgba(0,0,0,0.15) 100%);
}

.skeu-fader-thumb {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  width: 28px;
  height: 32px;
  background: linear-gradient(180deg, rgba(255,255,255,0.4), var(--control));
  border: 1px solid var(--hair);
  border-radius: 8px;
  box-shadow: var(--rim-1);
  cursor: ns-resize;
  touch-action: none;
  transition: transform var(--dur-1) var(--ease-out);
}

.skeu-fader-thumb:active { box-shadow: var(--rim-inset); transform: translateX(-50%) scale(0.95); }

.skeu-fader-value {
  font-size: var(--t-micro);
  color: var(--ink-3);
  margin-top: var(--sp-gap-xs);
  text-align: center;
}

/* Transport buttons (flat, tonal - NOT skeuomorphic) */
.transport-btn {
  width: 40px;
  height: 40px;
  border-radius: var(--r-item);
  border: 1px solid var(--hair);
  background: var(--control);
  color: var(--ink-1);
  display: grid;
  place-items: center;
  cursor: pointer;
  font-size: 16px;
  transition: background var(--dur-1) ease, transform var(--dur-1) var(--ease-out);
}

.transport-btn:hover { background: var(--control-hover); }
.transport-btn:active { background: var(--control-press); transform: scale(0.96); }
.transport-btn.active { background: var(--accent); color: var(--ink-on-accent); border-color: var(--accent); }
.transport-btn.record.active { background: var(--danger); color: var(--ink-on-accent); border-color: var(--danger); }

/* Piano roll */
.piano-roll-grid {
  position: relative;
  flex: 1;
  min-height: 0;
  overflow: auto;
  background: var(--panel-bottom);
}

.piano-key {
  position: relative;
  height: 22px;
  border-bottom: 1px solid var(--hair);
  cursor: pointer;
  display: grid;
  place-items: end;
  padding-right: 4px;
  font-size: var(--t-micro);
  color: var(--ink-4);
  transition: background var(--dur-1) ease;
}

.piano-key.white { background: #fff; }
.piano-key.black { background: var(--ink-1); color: #fff; }
.piano-key.scale-on { background: var(--accent-tint-2); }
.piano-key.scale-root { background: var(--accent-tint-3); box-shadow: inset 0 0 0 1px var(--accent); }

.piano-note {
  position: absolute;
  border-radius: 3px;
  border: 1px solid rgba(255,255,255,0.5);
  font-size: var(--t-micro);
  color: var(--ink-on-accent);
  padding: 1px 4px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  box-shadow: 0 0 0 var(--focus-width) var(--accent-glow);
  cursor: grab;
  touch-action: none;
}

.piano-note:active { cursor: grabbing; }
.piano-note.selected { border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent), 0 0 0 var(--focus-width) var(--accent-glow); }

/* Channel rack */
.channel-rack-step {
  width: 14px;
  height: 32px;
  border: none;
  cursor: pointer;
  color: var(--ink-4);
  font-size: 9px;
  display: grid;
  place-items: center;
  line-height: 1;
  transition: background var(--dur-1) ease;
}

.channel-rack-step:hover { background: var(--control-hover); }
.channel-rack-step.on { background: var(--accent); color: var(--ink-on-accent); }

/* Mixer fader */
.mixer-fader {
  width: var(--daw-fader-width);
  height: 160px;
  position: relative;
}

/* Meter */
.meter-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(180deg, var(--good), var(--warn), var(--danger));
  width: 100%;
  transition: height 50ms linear;
  transform-origin: bottom;
}

/* Status bar */
.status-bar {
  height: var(--status-h);
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 16px;
  background: rgba(255,255,255,0.20);
  backdrop-filter: blur(20px) saturate(130%);
  box-shadow: inset 0 1px 0 var(--seam);
  font-size: var(--t-meta);
  color: var(--ink-3);
}

[data-theme="dark"] .status-bar { background: rgba(255,255,255,0.022); }

/* Appbar */
.appbar {
  height: var(--appbar-h);
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 0 14px 0 15px;
  -webkit-app-region: drag;
}

.appbar > * { -webkit-app-region: no-drag; }

/* Search */
.search {
  position: relative;
  display: flex;
  align-items: center;
  gap: 8px;
  width: 214px;
  height: 34px;
  padding: 0 7px 0 10px;
  border-radius: var(--r-pill);
  background: var(--field);
  box-shadow: var(--e1), var(--rim-1);
  transition: background var(--dur-1) ease, box-shadow var(--dur-2) ease;
}

.search:hover { background: var(--field-hover); box-shadow: var(--e2), var(--rim-2); }
.search:focus-within {
  background: var(--field-hover);
  box-shadow: var(--e1), var(--rim-1), 0 0 0 3px var(--focus-halo);
  outline: 1px solid var(--accent);
  outline-offset: 0;
}

.search input {
  flex: 1;
  width: 100%;
  min-width: 0;
  height: 100%;
  border: 0;
  background: none;
  outline: none;
  font-size: 12.5px;
  font-weight: 480;
  letter-spacing: -0.002em;
  color: var(--ink-1);
}

.search input::placeholder { color: var(--ink-3); opacity: 1; }

/* Ask Smart pill */
.ask-smart {
  height: 34px;
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 0 12px 0 10px;
  border-radius: var(--r-pill);
  font-size: 12.5px;
  font-weight: 590;
  letter-spacing: -0.004em;
  color: var(--accent-ink);
  background: var(--accent-tint);
  box-shadow: var(--e1), var(--rim-1);
  transition: background var(--dur-2) ease, color var(--dur-2) ease, box-shadow var(--dur-2) ease, transform var(--dur-1) var(--ease-out);
}

.ask-smart:hover {
  color: var(--accent-ink);
  background: var(--accent-tint-3);
  box-shadow: var(--e2), var(--rim-2);
  transform: translateY(-1px);
}

.ask-smart .ic { color: var(--accent); }

/* Segmented view */
.seg {
  display: flex;
  align-items: center;
  gap: 1px;
  padding: 3px;
  border-radius: var(--r-pill);
  background: var(--control);
  box-shadow: var(--e1), var(--rim-1);
}

.seg button {
  width: 28px;
  height: 26px;
  display: grid;
  place-items: center;
  border-radius: var(--r-pill);
  color: var(--ink-3);
  transition: background var(--dur-2) var(--ease-out), color var(--dur-1) ease, box-shadow var(--dur-2) ease;
}

.seg button:hover { color: var(--ink-1); }
.seg button.on {
  background: var(--field-hover);
  color: var(--ink-1);
  box-shadow: var(--e1), var(--rim-1);
}

/* Sidebar */
.sidebar {
  flex: 0 0 var(--sidebar-w);
  width: var(--sidebar-w);
  display: flex;
  flex-direction: column;
  min-height: 0;
  background: linear-gradient(180deg, var(--sidebar-top), var(--sidebar-bottom));
  backdrop-filter: blur(34px) saturate(146%);
  transition: flex-basis var(--dur-3) var(--ease-out), width var(--dur-3) var(--ease-out), opacity var(--dur-2) ease, transform var(--dur-3) var(--ease-out);
  overflow: hidden;
}

.sidebar::after {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 1px;
  background: linear-gradient(180deg, rgba(255,255,255,.52), rgba(20,29,48,.055) 40%, rgba(20,29,48,.03));
  pointer-events: none;
}

[data-theme="dark"] .sidebar::after {
  background: linear-gradient(180deg, rgba(255,255,255,.09), rgba(0,0,0,.16));
}

.sb-top {
  flex: none;
  height: 54px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 13px 0 20px;
  -webkit-app-region: drag;
}

.sb-nav {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 0 12px 10px;
  scrollbar-width: none;
  overscroll-behavior: contain;
}

.sb-nav::-webkit-scrollbar { display: none; }

.sb-group { margin-bottom: 15px; }
.sb-group:last-child { margin-bottom: 2px; }

.sb-label {
  display: flex;
  align-items: center;
  height: 22px;
  padding: 0 10px;
  margin-bottom: 3px;
  font-size: var(--t-label);
  font-weight: 610;
  letter-spacing: var(--tracking-label);
  text-transform: uppercase;
  color: var(--ink-3);
}

.row {
  position: relative;
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  height: var(--row-h);
  padding: 0 10px;
  margin: 1px 0;
  border-radius: var(--r-item);
  color: var(--ink-2);
  font-size: 13px;
  font-weight: 510;
  letter-spacing: -0.004em;
  text-align: left;
  transition: background var(--dur-1) ease, color var(--dur-1) ease;
}

.row .ic { --ic: 18px; color: var(--ink-3); transition: color var(--dur-1) ease; }
.row:hover { background: var(--row-hover); color: var(--ink-1); }
.row:hover .ic { color: var(--ink-2); }
.row:active { background: var(--row-press); }
.row.active {
  background: var(--accent-tint);
  color: var(--accent-ink);
  font-weight: 565;
}

.row.active::before {
  content: "";
  position: absolute;
  left: 0; top: 8px; bottom: 8px;
  width: 3px;
  border-radius: 0 3px 3px 0;
  background: var(--accent);
}

.row.active .ic { color: var(--accent); }
.row.active .ic .o { opacity: 0; }
.row.active .ic .f { opacity: 1; }
.row .tail { margin-left: auto; font-size: 10.5px; font-weight: 560; color: var(--ink-3); }
.row.active .tail { color: var(--accent-ink); opacity: .72; }

/* Icon states */
.ic { --ic: 18px; color: inherit; }
.ic .o { opacity: 1; }
.ic .d, .ic .f { opacity: 0; }
.row:hover .ic .o, .iconbtn:hover .ic .o { opacity: 0; }
.row:hover .ic .d, .iconbtn:hover .ic .d { opacity: 1; }
.row.active .ic .d { opacity: 0; }
.row.active .ic .f { opacity: 1; }

/* Kbd */
.kbd {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 18px;
  height: 18px;
  padding: 0 4px;
  border-radius: var(--r-keycap);
  background: var(--field);
  box-shadow: var(--rim-1);
  color: var(--ink-3);
  font-size: var(--t-keycap);
  font-weight: 600;
  letter-spacing: .02em;
  line-height: 1;
  flex: none;
}

/* Content area */
.content {
  position: relative;
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 4px var(--pad-x) 26px;
  scrollbar-width: thin;
  scrollbar-color: rgba(20,29,48,.20) transparent;
  overscroll-behavior: contain;
}

.content::-webkit-scrollbar { width: 11px; }
.content::-webkit-scrollbar-track { background: transparent; }
.content::-webkit-scrollbar-thumb { background: rgba(20,29,48,.16); border: 4px solid transparent; background-clip: content-box; border-radius: 99px; }

/* Window */
.window {
  position: relative;
  display: flex;
  width: min(1440px, 100%);
  height: min(860px, 100%);
  border-radius: var(--r-window);
  overflow: hidden;
  isolation: isolate;
  background: linear-gradient(180deg, var(--window-top), var(--window-bottom));
  backdrop-filter: blur(64px) saturate(158%);
  box-shadow: var(--e5), var(--rim-5);
  transition: transform var(--dur-4) var(--ease-out), opacity var(--dur-3) ease, border-radius var(--dur-3) ease;
}

.window::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  z-index: 100;
  box-shadow: var(--rim-5), inset 0 0 0 1px rgba(255,255,255,.12);
}

[data-theme="dark"] .window::before {
  box-shadow: var(--rim-5), inset 0 0 0 1px rgba(255,255,255,.035);
}

/* Desktop */
.desktop {
  position: fixed;
  inset: 0;
  display: grid;
  place-items: center;
  padding: clamp(14px, 3.4vh, 38px) clamp(14px, 3.6vw, 58px);
  z-index: 2;
  background: var(--wall-base) var(--wall-image) center center / cover no-repeat fixed;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  background: var(--wall-veil);
  pointer-events: none;
  z-index: 1;
  transition: background var(--dur-4) var(--ease-in-out);
}

/* Main layout */
.main-layout {
  display: flex;
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.stage {
  position: relative;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, var(--content-top), var(--content-bottom));
}

/* DAW grid layout */
.daw-grid {
  display: grid;
  grid-template-columns: 280px 1fr 1fr;
  grid-template-rows: 1fr auto 1fr;
  grid-template-areas:
    "browser channel piano"
    "browser transport piano"
    "browser mixer piano";
  gap: var(--daw-pane-gap);
  padding: var(--daw-pane-gap);
  flex: 1;
  min-height: 0;
}

.browser-pane { grid-area: browser; }
.channel-pane { grid-area: channel; }
.piano-pane { grid-area: piano; }
.transport-pane { grid-area: transport; }
.mixer-pane { grid-area: mixer; }

/* Piano roll keyboard */
.piano-keyboard {
  width: 48px;
  flex-shrink: 0;
  border-right: 1px solid var(--hair);
  background: linear-gradient(180deg, var(--sidebar-top), var(--sidebar-bottom));
  display: flex;
  flex-direction: column;
}

/* Channel rack */
.channel-rack-grid {
  display: grid;
  grid-template-columns: 180px 1fr;
  gap: var(--sp-gap-sm);
  min-height: 0;
}

/* Mixer strip */
.mixer-strip {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--sp-gap-sm);
  padding: var(--sp-gap-sm);
  min-width: 100px;
  border: 1px solid var(--hair);
  border-radius: var(--r-card);
  background: linear-gradient(180deg, var(--panel-top), var(--panel-bottom));
  box-shadow: var(--e1), var(--rim-1);
}

.mixer-strip.master {
  border-color: var(--accent);
  box-shadow: var(--e2), var(--rim-accent);
}

/* Playlist */
.playlist-pane {
  display: none;
  flex-direction: column;
  grid-column: 1 / -1;
}

.playlist-pane.visible { display: flex; }

/* Command palette */
.cmd-palette {
  position: fixed;
  top: 12%;
  left: 50%;
  transform: translateX(-50%);
  width: 560px;
  max-width: 90vw;
  background: var(--menu-bg);
  border: 1px solid var(--hair);
  border-radius: var(--r-menu);
  box-shadow: var(--e5), var(--rim-5);
  z-index: 200;
  display: none;
  flex-direction: column;
}

.cmd-palette.open { display: flex; }

.cmd-search {
  width: 100%;
  padding: var(--sp-gap-md);
  background: var(--field);
  border: none;
  border-bottom: 1px solid var(--hair);
  font-size: var(--t-body);
  color: var(--ink-1);
  outline: none;
}

.cmd-results {
  flex: 1;
  overflow: auto;
  max-height: 300px;
}

.cmd-item {
  padding: var(--sp-gap-sm) var(--sp-gap-md);
  font-size: var(--t-body);
  color: var(--ink-1);
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  border-bottom: 1px solid var(--hair);
  transition: background var(--dur-1) ease;
}

.cmd-item:hover { background: var(--row-hover); }

/* AI history */
.ai-history {
  position: fixed;
  bottom: 0;
  right: 0;
  width: 340px;
  height: 200px;
  background: var(--panel-bottom);
  border: 1px solid var(--hair);
  border-top-left-radius: var(--r-panel);
  box-shadow: var(--e4), var(--rim-4);
  z-index: 150;
  display: none;
  flex-direction: column;
}

.ai-history.open { display: flex; }

.ai-history-header {
  padding: var(--sp-gap-sm) var(--sp-gap-md);
  border-bottom: 1px solid var(--hair);
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: var(--t-label);
  font-weight: var(--weight-medium);
  color: var(--ink-2);
}

.ai-history-list {
  flex: 1;
  overflow: auto;
  font-size: var(--t-meta);
  color: var(--ink-2);
  padding: var(--sp-gap-sm);
}

.ai-history-item {
  padding: var(--sp-gap-xs) 0;
  border-bottom: 1px solid var(--hair);
  display: flex;
  justify-content: space-between;
  gap: var(--sp-gap-sm);
}

.ai-history-undo {
  color: var(--accent);
  font-size: var(--t-micro);
  cursor: pointer;
}

/* AI pill */
.ai-pill {
  position: absolute;
  bottom: var(--sp-gap-md);
  right: var(--sp-gap-md);
  background: linear-gradient(180deg, var(--panel-top), var(--panel-bottom));
  border: 1px solid var(--hair);
  border-radius: var(--r-pill);
  padding: var(--sp-gap-xs) var(--sp-gap-md);
  display: flex;
  align-items: center;
  gap: var(--sp-gap-sm);
  box-shadow: var(--e2), var(--rim-2);
  z-index: 40;
  cursor: pointer;
  transition: border-color var(--dur-1) ease, box-shadow var(--dur-2) ease;
}

.ai-pill:hover { border-color: var(--accent); box-shadow: var(--e3), var(--rim-accent); }

.ai-icon {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: var(--accent);
  color: var(--ink-on-accent);
  display: grid;
  place-items: center;
  font-size: 12px;
  font-weight: var(--weight-bold);
}

.ai-label {
  font-size: var(--t-meta);
  color: var(--ink-2);
}

/* Tooltip */
.tooltip {
  position: absolute;
  pointer-events: none;
  z-index: 100;
  background: var(--tooltip-bg);
  color: var(--tooltip-ink);
  font-size: var(--t-micro);
  padding: var(--sp-gap-xs) var(--sp-gap-sm);
  border-radius: var(--r-item);
  border: 1px solid var(--hair);
  white-space: nowrap;
  opacity: 0;
  transition: opacity var(--dur-1) var(--ease-out);
}

.tooltip.show { opacity: 1; }

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
    scroll-behavior: auto !important;
  }
}

/* Responsive */
@media (max-width: 1024px) {
  .daw-grid {
    grid-template-columns: 1fr 1fr;
    grid-template-areas:
      "channel piano"
      "transport piano"
      "mixer piano";
  }
  .browser-pane { display: none; }
}

@media (max-width: 768px) {
  .daw-grid {
    grid-template-columns: 1fr;
    grid-template-areas:
      "piano"
      "transport"
      "mixer";
  }
  .browser-pane, .channel-pane { display: none; }
}
</style>
</head>
<body>
<!-- Wallpaper backdrop -->
<div class="desktop">
  <div class="window">
    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="sb-top">
        <div class="traffic">
          <button class="dot close" aria-label="Close"><svg viewBox="0 0 8 8"><path d="M1 1L7 7M7 1L1 7"/></svg></button>
          <button class="dot min" aria-label="Minimize"><svg viewBox="0 0 8 8"><path d="M1 4H7"/></svg></button>
          <button class="dot zoom" aria-label="Maximize"><svg viewBox="0 0 8 8"><path d="M1 1H7V7H1z"/></svg></button>
        </div>
        <button class="sb-collapse" title="Collapse sidebar (⌘\)"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 3L9 7L5 11"/></svg></button>
      </div>
      
      <div class="sb-nav">
        <div class="sb-group">
          <div class="sb-label">Browser</div>
          <button class="row active">
            <span class="ic"><svg class="o" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 5h14v10H3z"/><path d="M3 5l2-2h4l2 2"/></svg><svg class="f" viewBox="0 0 20 20" fill="currentColor"><path d="M3 5h14v10H3z"/><path d="M3 5l2-2h4l2 2"/></svg></span>
            Samples
            <span class="tail">16</span>
          </button>
          <button class="row">
            <span class="ic"><svg class="o" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 3h12v14H4z"/><path d="M7 6h6M7 9h6M7 12h4"/></svg><svg class="f" viewBox="0 0 20 20" fill="currentColor"><path d="M4 3h12v14H4z"/></svg></span>
            Instruments
            <span class="tail">8</span>
          </button>
          <button class="row">
            <span class="ic"><svg class="o" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="10" cy="10" r="6"/><path d="M10 6v4l2 2"/></svg><svg class="f" viewBox="0 0 20 20" fill="currentColor"><circle cx="10" cy="10" r="6"/></svg></span>
            Presets
            <span class="tail">24</span>
          </button>
          <button class="row">
            <span class="ic"><svg class="o" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h12v12H4z"/><path d="M7 7h6M7 10h6M7 13h4"/></svg><svg class="f" viewBox="0 0 20 20" fill="currentColor"><path d="M4 4h12v12H4z"/></svg></span>
            Projects
            <span class="tail">3</span>
          </button>
        </div>
        
        <div class="sb-group">
          <div class="sb-label">Channels</div>
          <button class="row" data-channel="1">
            <span class="tagdot" style="--c: #e74c3c"></span>
            Kick
            <span class="tail">16 steps</span>
          </button>
          <button class="row" data-channel="2">
            <span class="tagdot" style="--c: #3498db"></span>
            Snare
            <span class="tail">16 steps</span>
          </button>
          <button class="row" data-channel="3">
            <span class="tagdot" style="--c: #f1c40f"></span>
            HiHat
            <span class="tail">16 steps</span>
          </button>
          <button class="row" data-channel="4">
            <span class="tagdot" style="--c: #e67e22"></span>
            LogDrum
            <span class="tail">16 steps</span>
          </button>
          <button class="row" data-channel="5">
            <span class="tagdot" style="--c: #2ecc71"></span>
            Bass
            <span class="tail">4 notes</span>
          </button>
          <button class="row" data-channel="6">
            <span class="tagdot" style="--c: #9b59b6"></span>
            Chords
            <span class="tail">6 notes</span>
          </button>
          <button class="row" data-channel="7">
            <span class="tagdot" style="--c: #1abc9c"></span>
            Lead
            <span class="tail">4 notes</span>
          </button>
          <button class="row" data-channel="8">
            <span class="tagdot" style="--c: #34495e"></span>
            Pad
            <span class="tail">3 notes</span>
          </button>
        </div>
        
        <div class="sb-group">
          <div class="sb-label">Views</div>
          <button class="row" id="btn-playlist">
            <span class="ic"><svg class="o" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 4h14v12H3z"/><path d="M3 8h14M3 12h14"/></svg><svg class="f" viewBox="0 0 20 20" fill="currentColor"><path d="M3 4h14v12H3z"/></svg></span>
            Playlist
            <span class="kbd">⌘P</span>
          </button>
          <button class="row" id="btn-mixer">
            <span class="ic"><svg class="o" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4v12M8 4v12M12 4v12M16 4v12"/></svg><svg class="f" viewBox="0 0 20 20" fill="currentColor"><path d="M4 4v12M8 4v12M12 4v12M16 4v12"/></svg></span>
            Mixer
          </button>
          <button class="row" id="btn-browser">
            <span class="ic"><svg class="o" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 5h14v10H3z"/><path d="M3 5l2-2h4l2 2"/></svg><svg class="f" viewBox="0 0 20 20" fill="currentColor"><path d="M3 5h14v10H3z"/></svg></span>
            Browser
          </button>
        </div>
      </div>
      
      <div class="sb-foot">
        <div class="storage">
          <div class="storage-top">
            <span class="ic"><svg class="o" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h12v12H4z"/><path d="M7 7h6M7 10h6M7 13h4"/></svg></span>
            <b>Project size</b>
            <span class="storage-pct">2.4 MB</span>
          </div>
          <div class="meter"><i style="width: 62%"></i></div>
          <div class="storage-meta">Local storage · 3 projects</div>
        </div>
      </div>
    </aside>
    
    <!-- Stage -->
    <div class="stage">
      <!-- Appbar -->
      <div class="appbar">
        <div class="appbar-traffic">
          <button class="dot close" aria-label="Close"><svg viewBox="0 0 8 8"><path d="M1 1L7 7M7 1L1 7"/></svg></button>
          <button class="dot min" aria-label="Minimize"><svg viewBox="0 0 8 8"><path d="M1 4H7"/></svg></button>
          <button class="dot zoom" aria-label="Maximize"><svg viewBox="0 0 8 8"><path d="M1 1H7V7H1z"/></svg></button>
        </div>
        
        <div class="navpair">
          <button class="iconbtn sm" aria-label="Back"><svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 4L7 10L13 16"/></svg></button>
          <button class="iconbtn sm" aria-label="Forward"><svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7 4L13 10L7 16"/></svg></button>
        </div>
        
        <div class="crumbs">
          <button class="crumb current">
            <svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 4h14v12H3z"/><path d="M3 4l2-2h4l2 2"/></svg>
            <span>Smart DAW</span>
          </button>
          <span class="csep">›</span>
          <button class="crumb">
            <span>Project 1</span>
          </button>
        </div>
        
        <div class="appbar-spacer"></div>
        
        <div class="search" role="search">
          <svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="9" cy="9" r="5.5"/><path d="M13 13L17 17"/></svg>
          <input type="search" placeholder="Search samples…" aria-label="Search">
          <span class="kbd">/</span>
          <button class="search-clear" aria-label="Clear"><svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 5L15 15M15 5L5 15"/></svg></button>
        </div>
        
        <button class="ask-smart" aria-expanded="false">
          <svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10 2L12 8L18 8L13 12L15 18L10 14L5 18L7 12L2 8L8 8Z"/></svg>
          <span>Ask Smart</span>
          <span class="kbd">⌘K</span>
        </button>
        
        <div class="seg" role="group" aria-label="View">
          <button class="on" title="Grid view"><svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 3h6v6H3zM11 3h6v6h-6zM3 11h6v6H3zM11 11h6v6h-6z"/></svg></button>
          <button title="List view"><svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 4h14M3 8h14M3 12h14M3 16h14"/></svg></button>
        </div>
        
        <button class="iconbtn sm" aria-label="Theme" id="btn-theme">
          <svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="10" cy="10" r="4"/><path d="M10 2v2M10 16v2M2 10h2M16 10h2"/></svg>
        </button>
      </div>
      
      <!-- DAW Grid -->
      <div class="daw-grid">
        <!-- Browser Pane -->
        <div class="daw-pane browser-pane" id="pane-browser">
          <div class="daw-pane-header">
            <span class="daw-pane-title">Browser</span>
            <div class="daw-pane-actions">
              <button class="iconbtn sm" title="Float/dock"><svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h12v12H4z"/><path d="M4 8h12"/></svg></button>
              <button class="iconbtn sm" title="Close"><svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 5L15 15M15 5L5 15"/></svg></button>
            </div>
          </div>
          <div class="daw-pane-content">
            <div class="search" style="width: 100%; margin-bottom: 12px;">
              <svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="9" cy="9" r="5.5"/><path d="M13 13L17 17"/></svg>
              <input type="search" placeholder="Search samples…" aria-label="Search">
            </div>
            <div style="display: flex; flex-direction: column; gap: 4px;">
              <div style="display: flex; align-items: center; gap: 8px; padding: 6px 8px; border-radius: var(--r-item); background: var(--row-hover); cursor: pointer;">
                <svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" style="--ic: 16px;"><path d="M3 5h14v10H3z"/><path d="M3 5l2-2h4l2 2"/></svg>
                <span style="font-size: var(--t-body); color: var(--ink-1);">kick_808.wav</span>
                <span style="margin-left: auto; font-size: var(--t-micro); color: var(--ink-3);">0.5s</span>
              </div>
              <div style="display: flex; align-items: center; gap: 8px; padding: 6px 8px; border-radius: var(--r-item); cursor: pointer;">
                <svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" style="--ic: 16px;"><path d="M3 5h14v10H3z"/><path d="M3 5l2-2h4l2 2"/></svg>
                <span style="font-size: var(--t-body); color: var(--ink-2);">kick_logdrum.wav</span>
                <span style="margin-left: auto; font-size: var(--t-micro); color: var(--ink-3);">0.4s</span>
              </div>
              <div style="display: flex; align-items: center; gap: 8px; padding: 6px 8px; border-radius: var(--r-item); cursor: pointer;">
                <svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" style="--ic: 16px;"><path d="M3 5h14v10H3z"/><path d="M3 5l2-2h4l2 2"/></svg>
                <span style="font-size: var(--t-body); color: var(--ink-2);">snare_clap.wav</span>
                <span style="margin-left: auto; font-size: var(--t-micro); color: var(--ink-3);">0.3s</span>
              </div>
              <div style="display: flex; align-items: center; gap: 8px; padding: 6px 8px; border-radius: var(--r-item); cursor: pointer;">
                <svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" style="--ic: 16px;"><path d="M3 5h14v10H3z"/><path d="M3 5l2-2h4l2 2"/></svg>
                <span style="font-size: var(--t-body); color: var(--ink-2);">hihat_closed.wav</span>
                <span style="margin-left: auto; font-size: var(--t-micro); color: var(--ink-3);">0.15s</span>
              </div>
              <div style="display: flex; align-items: center; gap: 8px; padding: 6px 8px; border-radius: var(--r-item); cursor: pointer;">
                <svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" style="--ic: 16px;"><path d="M3 5h14v10H3z"/><path d="M3 5l2-2h4l2 2"/></svg>
                <span style="font-size: var(--t-body); color: var(--ink-2);">bass_deep.wav</span>
                <span style="margin-left: auto; font-size: var(--t-micro); color: var(--ink-3);">1.0s</span>
              </div>
              <div style="display: flex; align-items: center; gap: 8px; padding: 6px 8px; border-radius: var(--r-item); cursor: pointer;">
                <svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" style="--ic: 16px;"><path d="M3 5h14v10H3z"/><path d="M3 5l2-2h4l2 2"/></svg>
                <span style="font-size: var(--t-body); color: var(--ink-2);">chord_stab.wav</span>
                <span style="margin-left: auto; font-size: var(--t-micro); color: var(--ink-3);">0.5s</span>
              </div>
              <div style="display: flex; align-items: center; gap: 8px; padding: 6px 8px; border-radius: var(--r-item); cursor: pointer;">
                <svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" style="--ic: 16px;"><path d="M3 5h14v10H3z"/><path d="M3 5l2-2h4l2 2"/></svg>
                <span style="font-size: var(--t-body); color: var(--ink-2);">piano_lead.wav</span>
                <span style="margin-left: auto; font-size: var(--t-micro); color: var(--ink-3);">0.8s</span>
              </div>
              <div style="display: flex; align-items: center; gap: 8px; padding: 6px 8px; border-radius: var(--r-item); cursor: pointer;">
                <svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" style="--ic: 16px;"><path d="M3 5h14v10H3z"/><path d="M3 5l2-2h4l2 2"/></svg>
                <span style="font-size: var(--t-body); color: var(--ink-2);">pad_warm.wav</span>
                <span style="margin-left: auto; font-size: var(--t-micro); color: var(--ink-3);">1.5s</span>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Channel Rack Pane -->
        <div class="daw-pane channel-pane" id="pane-channel">
          <div class="daw-pane-header">
            <span class="daw-pane-title">Channel Rack</span>
            <div class="daw-pane-actions">
              <button class="iconbtn sm" title="Add channel"><svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10 4v12M4 10h12"/></svg></button>
              <button class="iconbtn sm" title="Float/dock"><svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h12v12H4z"/><path d="M4 8h12"/></svg></button>
              <button class="iconbtn sm" title="Close"><svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 5L15 15M15 5L5 15"/></svg></button>
            </div>
          </div>
          <div class="daw-pane-content">
            <div style="display: flex; flex-direction: column; gap: 4px;">
              <!-- Channel rows will be rendered here by JS -->
            </div>
          </div>
        </div>
        
        <!-- Piano Roll Pane -->
        <div class="daw-pane piano-pane" id="pane-piano">
          <div class="daw-pane-header">
            <span class="daw-pane-title">Piano Roll</span>
            <div class="daw-pane-actions">
              <button class="iconbtn sm" title="Float/dock"><svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h12v12H4z"/><path d="M4 8h12"/></svg></button>
              <button class="iconbtn sm" title="Close"><svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 5L15 15M15 5L5 15"/></svg></button>
            </div>
          </div>
          <div class="daw-pane-content" style="display: flex; flex-direction: column; overflow: hidden;">
            <!-- Scale controls -->
            <div style="display: flex; align-items: center; gap: 8px; padding: 4px 0; border-bottom: 1px solid var(--hair); flex-shrink: 0;">
              <label style="font-size: var(--t-label); color: var(--ink-3);">Scale</label>
              <select id="scale-select" style="background: var(--field); border: 1px solid var(--hair); border-radius: var(--r-pill); padding: 2px 8px; font-size: var(--t-body); color: var(--ink-1); outline: none;">
                <option value="chromatic">Chromatic</option>
                <option value="C:major">C major</option>
                <option value="A:minor">A minor</option>
                <option value="F:lydian">F lydian</option>
                <option value="C:pentatonic">C pentatonic</option>
              </select>
              <button class="iconbtn sm" id="btn-scale-highlight" title="Toggle scale highlight (S)"><svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10 2L12 8L18 8L13 12L15 18L10 14L5 18L7 12L2 8L8 8Z"/></svg></button>
              <button class="iconbtn sm" id="btn-snap-scale" title="Snap to scale"><svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 10L8 14L16 6"/></svg></button>
            </div>
            <!-- Piano keyboard + roll area -->
            <div style="display: flex; flex: 1; min-height: 0; overflow: hidden;">
              <div class="piano-keyboard" id="piano-keyboard" style="width: 48px; flex-shrink: 0; border-right: 1px solid var(--hair); background: linear-gradient(180deg, var(--sidebar-top), var(--sidebar-bottom)); display: flex; flex-direction: column;"></div>
              <div style="flex: 1; display: flex; flex-direction: column; min-width: 0; overflow: hidden;">
                <div class="piano-roll-grid" id="piano-roll-area" style="flex: 1; position: relative; overflow: auto; background: var(--panel-bottom);">
                  <div style="position: absolute; top: 0; left: 0; right: 0; height: 24px; border-bottom: 1px solid var(--hair); display: flex; background: linear-gradient(180deg, var(--sidebar-top), var(--sidebar-bottom)); z-index: 10;" id="piano-ruler"></div>
                  <div style="position: absolute; top: 24px; left: 0; right: 0; bottom: 0; display: grid; grid-template-rows: repeat(48, 22px); border-right: 1px solid var(--hair);" id="piano-grid"></div>
                  <div style="position: absolute; top: 24px; left: 0; right: 0; bottom: 0; z-index: 20;" id="piano-notes"></div>
                  <div style="position: absolute; left: 0; top: 0; bottom: 0; width: var(--daw-playhead-width); background: var(--accent); pointer-events: none; z-index: 30; transition: left 0ms linear;" id="playhead"></div>
                </div>
                <!-- Velocity lane -->
                <div style="height: 60px; border-top: 1px solid var(--hair); background: var(--panel-bottom); position: relative; flex-shrink: 0;" id="velocity-lane">
                  <div style="position: absolute; top: 0; left: 48px; right: 0; bottom: 0; display: flex; align-items: flex-end; gap: 1px; padding: 2px;" id="velocity-bars"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Transport Pane -->
        <div class="daw-pane transport-pane" id="pane-transport">
          <div class="daw-pane-content" style="padding: 4px 8px; display: flex; align-items: center; gap: 8px; overflow-x: auto; position: relative;">
            <button class="transport-btn" id="tr-stop" title="Stop (Space)"><svg class="ic" viewBox="0 0 20 20" fill="currentColor"><rect x="5" y="5" width="10" height="10"/></svg></button>
            <button class="transport-btn active" id="tr-play" title="Play (Space)"><svg class="ic" viewBox="0 0 20 20" fill="currentColor"><path d="M6 4L16 10L6 16z"/></svg></button>
            <button class="transport-btn record" id="tr-record" title="Record (R)"><svg class="ic" viewBox="0 0 20 20" fill="currentColor"><circle cx="10" cy="10" r="5"/></svg></button>
            <button class="transport-btn" id="tr-loop" title="Loop (L)"><svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 10A6 6 0 0 1 10 4L16 4M16 10A6 6 0 0 1 10 16L4 16"/></svg></button>
            <button class="transport-btn" id="tr-metro" title="Metronome"><svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 16L10 4L14 16M7 13H13"/></svg></button>
            <div style="width: 1px; height: 20px; background: var(--hair); margin: 0 4px;"></div>
            <div style="display: flex; align-items: center; gap: 4px; background: var(--field); border: 1px solid var(--hair); border-radius: var(--r-pill); padding: 2px 8px;">
              <span style="font-size: var(--t-meta); color: var(--ink-2);">BPM</span>
              <input type="number" id="tr-field-bpm" value="124" min="20" max="300" style="background: transparent; border: none; color: var(--ink-1); font-family: monospace; font-size: var(--t-meta); width: 44px; outline: none;">
            </div>
            <span style="font-size: var(--t-meta); color: var(--ink-2); font-family: monospace;" id="song-pos">1.1.000</span>
            <div style="width: 1px; height: 20px; background: var(--hair); margin: 0 4px;"></div>
            <span style="font-size: var(--t-meta); color: var(--ink-2);">Loop</span>
            <span style="font-size: var(--t-meta); color: var(--ink-2); font-family: monospace;" id="loop-range">1.1 — 4.1</span>
            <button class="transport-btn" id="btn-loop-in" title="Loop in" style="width: 32px; height: 32px; font-size: 12px;">I</button>
            <button class="transport-btn" id="btn-loop-out" title="Loop out" style="width: 32px; height: 32px; font-size: 12px;">O</button>
            <div style="width: 1px; height: 20px; background: var(--hair); margin: 0 4px;"></div>
            <button class="transport-btn" id="btn-export" title="Export project" style="width: 32px; height: 32px; font-size: 12px;">⤓</button>
            <button class="transport-btn" id="btn-import" title="Import project" style="width: 32px; height: 32px; font-size: 12px;">⥮</button>
            <div class="ai-pill" id="ai-pill" title="AI suggestion (Ctrl+K)">
              <div class="ai-icon">✦</div>
              <div class="ai-label">AI: "log drum pattern"</div>
            </div>
          </div>
        </div>
        
        <!-- Mixer Pane -->
        <div class="daw-pane mixer-pane" id="pane-mixer">
          <div class="daw-pane-header">
            <span class="daw-pane-title">Mixer</span>
            <div class="daw-pane-actions">
              <button class="iconbtn sm" title="Float/dock"><svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h12v12H4z"/><path d="M4 8h12"/></svg></button>
              <button class="iconbtn sm" title="Close"><svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 5L15 15M15 5L5 15"/></svg></button>
            </div>
          </div>
          <div class="daw-pane-content" style="display: flex; flex-direction: column; gap: 8px; overflow-y: auto;">
            <!-- Mixer strips will be rendered here by JS -->
          </div>
        </div>
      </div>
      
      <!-- Playlist Pane (hidden by default) -->
      <div class="daw-pane playlist-pane" id="pane-playlist" style="display: none;">
        <div class="daw-pane-header">
          <span class="daw-pane-title">Playlist / Arrangement</span>
          <div class="daw-pane-actions">
            <button class="iconbtn sm" title="Float/dock"><svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h12v12H4z"/><path d="M4 8h12"/></svg></button>
            <button class="iconbtn sm" title="Close"><svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 5L15 15M15 5L5 15"/></svg></button>
          </div>
        </div>
        <div class="daw-pane-content" style="display: flex; flex-direction: column; overflow: hidden;">
          <div style="height: 26px; border-bottom: 1px solid var(--hair); display: flex; background: linear-gradient(180deg, var(--sidebar-top), var(--sidebar-bottom)); flex-shrink: 0;" id="playlist-ruler"></div>
          <div style="flex: 1; position: relative; overflow: auto; background: var(--panel-bottom);" id="playlist-area">
            <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; display: grid; grid-template-rows: repeat(8, 60px); border-right: 1px solid var(--hair);" id="playlist-grid"></div>
            <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; z-index: 20;" id="playlist-clips"></div>
          </div>
        </div>
      </div>
      
      <!-- Status Bar -->
      <div class="status-bar">
        <div style="display: flex; align-items: center; gap: 7px;">
          <b>Smart DAW</b>
          <span>·</span>
          <span>1.1.000</span>
          <span>·</span>
          <span>124 BPM</span>
        </div>
        <div style="flex: 1;"></div>
        <div style="display: flex; align-items: center; gap: 11px;">
          <span>⌘K Ask Smart</span>
          <span>⌘P Playlist</span>
          <span>⌘\ Sidebar</span>
        </div>
      </div>
    </div>
  </div>
</div>

    <!-- FX Rack Pane (hidden by default) -->
    <div class="daw-pane" id="pane-fx" style="display: none; position: fixed; top: 100px; right: 100px; width: 340px; height: 400px; z-index: 50;">
      <div class="daw-pane-header">
        <span class="daw-pane-title">FX Rack</span>
        <div class="daw-pane-actions">
          <button class="iconbtn sm" title="Float/dock"><svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h12v12H4z"/><path d="M4 8h12"/></svg></button>
          <button class="iconbtn sm" title="Close"><svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 5L15 15M15 5L5 15"/></svg></button>
        </div>
      </div>
      <div class="daw-pane-content" style="display: flex; flex-direction: column; gap: 8px;">
        <div style="font-size: var(--t-label); color: var(--ink-3);">Insert effects on Master</div>
        <div class="insert-slot">EQ</div>
        <div class="insert-slot">Compressor</div>
        <div class="insert-slot">Reverb</div>
        <div class="insert-slot">Limiter</div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-gap-md); margin-top: var(--sp-gap-md);">
          <div style="display: flex; flex-direction: column; align-items: center; gap: var(--sp-gap-xs);">
            <div class="skeu-knob" data-knob="fx-reverb" style="--knob-rot: 60deg;"><div class="pointer"></div><div class="value-ring"></div></div>
            <div class="skeu-knob-label">Reverb</div>
          </div>
          <div style="display: flex; flex-direction: column; align-items: center; gap: var(--sp-gap-xs);">
            <div class="skeu-knob" data-knob="fx-delay" style="--knob-rot: 45deg;"><div class="pointer"></div><div class="value-ring"></div></div>
            <div class="skeu-knob-label">Delay</div>
          </div>
        </div>
        <div style="margin-top: var(--sp-gap-md); font-size: var(--t-label); color: var(--ink-3);">Available Plugins</div>
        <div style="display: flex; flex-direction: column; gap: 4px;">
          <div style="padding: 6px 8px; border-radius: var(--r-item); background: var(--control); cursor: pointer; font-size: var(--t-body); color: var(--ink-2);">Parametric EQ</div>
          <div style="padding: 6px 8px; border-radius: var(--r-item); background: var(--control); cursor: pointer; font-size: var(--t-body); color: var(--ink-2);">Compressor</div>
          <div style="padding: 6px 8px; border-radius: var(--r-item); background: var(--control); cursor: pointer; font-size: var(--t-body); color: var(--ink-2);">Reverb</div>
          <div style="padding: 6px 8px; border-radius: var(--r-item); background: var(--control); cursor: pointer; font-size: var(--t-body); color: var(--ink-2);">Delay</div>
          <div style="padding: 6px 8px; border-radius: var(--r-item); background: var(--control); cursor: pointer; font-size: var(--t-body); color: var(--ink-2);">Chorus</div>
          <div style="padding: 6px 8px; border-radius: var(--r-item); background: var(--control); cursor: pointer; font-size: var(--t-body); color: var(--ink-2);">Limiter</div>
        </div>
      </div>
    </div>
    
    <!-- Sampler Pane (hidden by default) -->
    <div class="daw-pane" id="pane-sampler" style="display: none; position: fixed; top: 150px; right: 150px; width: 340px; height: 400px; z-index: 50;">
      <div class="daw-pane-header">
        <span class="daw-pane-title">Sampler — Kick</span>
        <div class="daw-pane-actions">
          <button class="iconbtn sm" title="Float/dock"><svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h12v12H4z"/><path d="M4 8h12"/></svg></button>
          <button class="iconbtn sm" title="Close"><svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 5L15 15M15 5L5 15"/></svg></button>
        </div>
      </div>
      <div class="daw-pane-content" style="display: flex; flex-direction: column; gap: 8px;">
        <div style="font-size: var(--t-label); color: var(--ink-3);">Sample</div>
        <div style="background: var(--field); border: 1px solid var(--hair); border-radius: var(--r-pill); padding: 6px 12px; font-size: var(--t-body); color: var(--ink-2);">kick_808.wav</div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-gap-md);">
          <div style="display: flex; flex-direction: column; align-items: center; gap: var(--sp-gap-xs);">
            <div class="skeu-knob" data-knob="sam-start" style="--knob-rot: 0deg;"><div class="pointer"></div><div class="value-ring"></div></div>
            <div class="skeu-knob-label">Start</div>
          </div>
          <div style="display: flex; flex-direction: column; align-items: center; gap: var(--sp-gap-xs);">
            <div class="skeu-knob" data-knob="sam-end" style="--knob-rot: 180deg;"><div class="pointer"></div><div class="value-ring"></div></div>
            <div class="skeu-knob-label">End</div>
          </div>
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-gap-md);">
          <div style="display: flex; flex-direction: column; align-items: center; gap: var(--sp-gap-xs);">
            <div class="skeu-knob" data-knob="sam-pitch" style="--knob-rot: 90deg;"><div class="pointer"></div><div class="value-ring"></div></div>
            <div class="skeu-knob-label">Pitch</div>
          </div>
          <div style="display: flex; flex-direction: column; align-items: center; gap: var(--sp-gap-xs);">
            <div class="skeu-knob" data-knob="sam-decay" style="--knob-rot: 120deg;"><div class="pointer"></div><div class="value-ring"></div></div>
            <div class="skeu-knob-label">Decay</div>
          </div>
        </div>
        <button class="add-channel" style="width: auto; padding: 6px var(--sp-gap-md); margin-top: var(--sp-gap-md);">One-shot trigger</button>
      </div>
    </div>
    
    <!-- Command Palette -->
    <div class="cmd-palette" id="cmd-palette" role="dialog" aria-modal="true" aria-label="Command palette">
      <input type="text" class="cmd-search" placeholder="Ask Smart… (e.g. 'make a log drum pattern')" aria-label="Command input">
      <div class="cmd-results" id="cmd-results"></div>
    </div>
    
    <!-- AI History -->
    <div class="ai-history" id="ai-history" aria-label="AI history">
      <div class="ai-history-header"><span>AI history</span><button id="ai-history-close">✕</button></div>
      <div class="ai-history-list" id="ai-history-list"></div>
    </div>
    
    <!-- Tooltip -->
    <div class="tooltip" id="tooltip"></div>

<script src="assets/icons.js"></script>
<script src="js/audio.js"></script>
<script src="js/daw.js"></script>
<script src="js/app.js"></script>
</body>
</html>
